# ==========================================
# VYRO AI CREATIVE STUDIO - PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Port & Server Configuration
PORT=3000
NODE_ENV=production

# Server Session & Owner Cryptographic Secret (32+ hex bytes)
OWNER_SESSION_SECRET=

# AI Studio Auto-Injected API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ==========================================
# OPTIONAL AI PROVIDER SECRETS (SETUP_REQUIRED until configured)
# ==========================================
RUNWAY_API_KEY=
OPENAI_API_KEY=
BFL_API_KEY=
FLUX_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
STABILITY_API_KEY=

# ==========================================
# PAYMENT GATEWAY SECRETS (SETUP_REQUIRED for live merchant transactions)
# ==========================================
# Razorpay Configuration:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe Configuration (Alternative):
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ==========================================
# CENTRALIZED PERSISTENCE & STORAGE (SETUP_REQUIRED for centralized cloud)
# ==========================================
# Option A: PostgreSQL / Google Cloud SQL:
DATABASE_URL=
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# Option B: Firebase Firestore (Alternative):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Cloud Object Storage (GCS / AWS S3) for large raw video/media assets:
# Google Cloud Storage (Option A):
GCS_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=

# Amazon S3 (Option B):
AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

